{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Web Debug (Chrome)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/apps/web",
            // Starts the Vite dev server (see .vscode/tasks.json) and waits
            // for it to be ready before launching the browser.
            "preLaunchTask": "web: vite dev server",
            // Kills the Vite dev server when the debug session ends (browser
            // window closed, or Stop pressed) — see scripts/stop-port.mjs.
            "postDebugTask": "web: stop vite",
            "presentation": {
                "order": 0
            }
        },
        {
            "name": "Desktop Debug Main Process",
            "request": "launch",
            "runtimeArgs": [
                "--filter",
                "@orca/desktop",
                "dev",
                "--sourcemap"
            ],
            "runtimeExecutable": "pnpm",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node",
            "env": {
                "REMOTE_DEBUGGING_PORT": "9222"
            }
        },
        {
            "name": "Desktop Debug Renderer Process",
            "port": 9222,
            "request": "attach",
            "type": "chrome",
            "webRoot": "${workspaceFolder}/apps/desktop/src/renderer",
            "timeout": 60000,
            "presentation": {
                "hidden": true
            }
        }
    ],
    "compounds": [
        {
            "name": "Desktop Debug All",
            "configurations": [
                "Desktop Debug Main Process",
                "Desktop Debug Renderer Process"
            ],
            "presentation": {
                "order": 1
            }
        }
    ]
}