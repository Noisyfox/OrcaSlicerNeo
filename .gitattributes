# Batch files must stay CRLF: cmd's parser misbehaves on LF-only .bat
# (multiline if-blocks get misparsed). Written by the build scripts, not
# by hand, so pin the eol for every checkout.
*.bat text eol=crlf

# WASM source patches are consumed by `git apply`; their context must retain
# LF line endings regardless of a developer's core.autocrlf setting.
/packages/slicer-wasm/patches/**/*.patch text eol=lf

# MCUT's patch data retains the exact upstream context (tabs and trailing
# blanks). Check source whitespace normally, rather than treating that data
# as newly added C++ indentation.
/packages/slicer-wasm/patches/mcut/*.patch whitespace=-blank-at-eol,-space-before-tab

# Unified diff context represents an empty OCCT source line with one space.
/packages/slicer-wasm/patches/occt/*.patch whitespace=-blank-at-eol
