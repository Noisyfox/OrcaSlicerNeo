{
  "name": "@orca/slicer-wasm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "WASM libslic3r module: Emscripten build scaffold + bridge + typed JS client",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "profile-smoke": "node harness/profile-smoke.mjs",
    "profile-compatibility-smoke": "node harness/profile-compatibility-smoke.mjs",
    "step-import-smoke": "node harness/step-import-smoke.mjs",
    "scoped-config-interoperability": "node harness/scoped-config-interoperability.mjs --module out/serial/orca_slice.js",
    "scoped-config-interoperability:threaded": "node harness/scoped-config-interoperability.mjs --module out/threaded/orca_slice.js",
    "native-project-preset-history-smoke": "node harness/native-project-preset-history-smoke.mjs out/serial/orca_slice.js",
    "native-project-preset-history-smoke:threaded": "node harness/native-project-preset-history-smoke.mjs out/threaded/orca_slice.js",
    "preset-draft-registry-smoke": "node harness/preset-draft-registry-smoke.mjs --module out/serial/orca_slice.js",
    "preset-draft-registry-smoke:threaded": "node harness/preset-draft-registry-smoke.mjs --module out/threaded/orca_slice.js",
    "project-preset-restoration": "node harness/project-preset-restoration.mjs --module out/serial/orca_slice.js",
    "sinking-out-of-bounds-smoke": "node harness/sinking-out-of-bounds-smoke.mjs out/serial/orca_slice.js"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  }
}
