    "filament-vector-project-benchmark": "node harness/filament-vector-project-benchmark.mjs",
    "project-preset-restoration": "node harness/project-preset-restoration.mjs --module out/serial/orca_slice.js",
    "sinking-out-of-bounds-smoke": "node harness/sinking-out-of-bounds-smoke.mjs out/serial/orca_slice.js"
