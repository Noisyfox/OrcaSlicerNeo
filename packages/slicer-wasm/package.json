    "native-project-preset-history-smoke:threaded": "node harness/native-project-preset-history-smoke.mjs out/threaded/orca_slice.js",
    "native-printer-transition-smoke": "node harness/native-printer-transition-smoke.mjs out/serial/orca_slice.js",
    "native-printer-transition-smoke:threaded": "node harness/native-printer-transition-smoke.mjs out/threaded/orca_slice.js",
    "prime-tower-slice-settings-smoke": "node harness/prime-tower-slice-settings-smoke.mjs out/serial/orca_slice.js",
