    "vendor-cache-disabled-smoke": "node harness/vendor-cache-disabled-smoke.mjs out/serial/orca_slice.js",
    "vendor-cache-disabled-smoke:threaded": "node harness/vendor-cache-disabled-smoke.mjs out/threaded/orca_slice.js",
    "profile-smoke": "node harness/profile-smoke.mjs",
    "profile-compatibility-smoke": "node harness/profile-compatibility-smoke.mjs",
    "step-import-smoke": "node harness/step-import-smoke.mjs",
    "scoped-config-interoperability": "node harness/scoped-config-interoperability.mjs --module out/serial/orca_slice.js",
    "scoped-config-interoperability:threaded": "node harness/scoped-config-interoperability.mjs --module out/threaded/orca_slice.js",
    "painting-session-smoke": "node harness/painting-session-smoke.mjs out/serial/orca_slice.js",
