solid floatingbox
  facet normal 0 0 400
    outer loop
      vertex 0 0 0.3
      vertex 20 0 0.3
      vertex 20 20 0.3
    endloop
  endfacet
  facet normal 0 0 400
    outer loop
      vertex 0 0 0.3
      vertex 20 20 0.3
      vertex 0 20 0.3
    endloop
  endfacet
  facet normal 0 0 -400
    outer loop
      vertex 20 0 5.3
      vertex 0 0 5.3
      vertex 0 20 5.3
    endloop
  endfacet
  facet normal 0 0 -400
    outer loop
      vertex 20 0 5.3
      vertex 0 20 5.3
      vertex 20 20 5.3
    endloop
  endfacet
  facet normal -100 0 0
    outer loop
      vertex 20 0 0.3
      vertex 20 0 5.3
      vertex 20 20 5.3
    endloop
  endfacet
  facet normal -100 0 0
    outer loop
      vertex 20 0 0.3
      vertex 20 20 5.3
      vertex 20 20 0.3
    endloop
  endfacet
  facet normal 100 0 0
    outer loop
      vertex 0 0 5.3
      vertex 0 0 0.3
      vertex 0 20 0.3
    endloop
  endfacet
  facet normal 100 0 0
    outer loop
      vertex 0 0 5.3
      vertex 0 20 0.3
      vertex 0 20 5.3
    endloop
  endfacet
  facet normal 0 -100 0
    outer loop
      vertex 0 20 0.3
      vertex 20 20 0.3
      vertex 20 20 5.3
    endloop
  endfacet
  facet normal 0 -100 0
    outer loop
      vertex 0 20 0.3
      vertex 20 20 5.3
      vertex 0 20 5.3
    endloop
  endfacet
  facet normal 0 100 0
    outer loop
      vertex 0 0 5.3
      vertex 20 0 5.3
      vertex 20 0 0.3
    endloop
  endfacet
  facet normal 0 100 0
    outer loop
      vertex 0 0 5.3
      vertex 20 0 0.3
      vertex 0 0 0.3
    endloop
  endfacet
endsolid floatingbox
