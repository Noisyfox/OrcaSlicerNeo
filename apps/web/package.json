{
  "name": "@orca/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/stage.mjs --soft",
    "dev": "vite",
    "predev:singlethread": "node ../../scripts/stage.mjs --soft",
    "dev:singlethread": "vite --mode singlethread",
    "prebuild": "node ../../scripts/stage.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test:non-root": "pnpm build && node scripts/non-root-smoke.mjs",
    "test:e2e:threaded": "pnpm --filter @orca/desktop exec playwright test --config ../../apps/web/playwright.config.ts",
    "test:e2e:serial": "node ../../scripts/run-web-e2e-serial.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@orca/printer-control": "workspace:*",
    "@orca/platform-contract": "workspace:*",
    "@orca/slicer-app": "workspace:*",
    "@orca/slicer-runtime": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
