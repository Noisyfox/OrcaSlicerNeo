{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["../../packages/slicer-app/src/*"],
      "@orca/slicer-app": ["../../packages/slicer-app/src/index.ts"],
      "@orca/slicer-app-css": ["../../packages/slicer-app/src/index.css"],
      "@orca/slicer-runtime": ["../../packages/slicer-runtime/src/index.ts"],
      "@orca/platform-contract": ["../../packages/platform-contract/src/index.ts"],
      "@slicer/client": ["../../packages/slicer-wasm/src/client/index.ts"],
      "@slicer/testing": ["../../packages/slicer-wasm/src/client/testing/mock-module.ts"]
    }
  },
  "include": [
    "src/**/*",
    "../../packages/slicer-app/src/**/*",
    "../../packages/slicer-runtime/src/**/*",
    "../../packages/platform-contract/src/**/*"
  ]
}