{
  "name": "@orca/desktop",
  "productName": "OrcaSlicerNeo",
  "version": "0.0.0",
  "private": true,
  "description": "OrcaSlicerNeo desktop app (Electron)",
  "author": "OrcaSlicerNeo contributors",
  "license": "AGPL-3.0",
  "main": "out/main/index.js",
  "scripts": {
    "camera:prototype": "node scripts/camera-prototype/run.mjs",
    "camera:player:check": "node scripts/camera-prototype/playback-check.mjs",
    "camera:prototype:test": "node --test scripts/camera-prototype/remux.test.mjs",
    "predev": "pnpm --filter @orca/bambu-native stage:runtime && node ../../scripts/stage.mjs --soft",
    "dev": "electron-vite dev --noSandbox",
    "prebuild": "pnpm --filter @orca/bambu-native stage:runtime && node ../../scripts/stage.mjs",
    "build": "electron-vite build",
    "test": "vitest run --passWithNoTests",
    "test:css": "electron-vite build && node scripts/check-renderer-css.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "prepackage:win": "node ../../scripts/stage.mjs",
    "package:win": "electron-vite build && electron-builder --win --x64 --publish never",
    "prepackage:dir": "node ../../scripts/stage.mjs",
    "package:dir": "electron-vite build && electron-builder --dir --publish never",
    "prepackage": "node ../../scripts/stage.mjs",
    "package": "electron-vite build && electron-builder --publish never",
    "postinstall": "install-electron",
    "pretest:e2e": "pnpm --filter @orca/bambu-native stage:runtime",
    "pretest:e2e:real": "pnpm --filter @orca/bambu-native stage:runtime",
    "test:e2e": "node ../../packages/slicer-wasm/harness/acquire-project-fixtures.mjs --download && node ../../scripts/stage.mjs --soft && electron-vite build --mode e2e && node scripts/check-renderer-css.mjs && playwright test e2e/bambu-account.e2e.ts e2e/bambu-provider.e2e.ts e2e/bambu-control.e2e.ts e2e/setup-wizard.e2e.ts e2e/utility-runtime.e2e.ts e2e/app.e2e.ts e2e/titlebar-menu.e2e.ts e2e/native-menu.e2e.ts e2e/slice-error.e2e.ts e2e/select-scroll.e2e.ts e2e/printer-control.e2e.ts e2e/profile-compatibility.e2e.ts e2e/project-lifecycle.e2e.ts e2e/multi-filament.e2e.ts e2e/preset-editor.e2e.ts e2e/color-picker.e2e.ts e2e/bed-type-selector.e2e.ts e2e/project-flow.e2e.ts e2e/prime-tower.e2e.ts e2e/painted-facet.e2e.ts e2e/plate-list.e2e.ts",
    "test:e2e:real": "node ../../scripts/stage.mjs && node ../../scripts/run-desktop-e2e-real.mjs",
    "test:e2e:painted-facet:real": "node ../../scripts/run-painted-facet-preview-e2e.mjs",
    "test:e2e:real-project-profile": "node ../../scripts/run-real-project-profile.mjs",
    "test:e2e:prime-tower-warnings": "node ../../scripts/stage.mjs --soft && node scripts/run-prime-tower-warning-e2e.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@orca/bambu-native": "workspace:*",
    "@orca/platform-contract": "workspace:*",
    "@orca/printer-control": "workspace:*",
    "@orca/service-provider": "workspace:*",
    "@orca/slicer-app": "workspace:*",
    "@orca/slicer-runtime": "workspace:*",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.31.0",
    "proper-lockfile": "4.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "saxes": "6.0.0",
    "three": "^0.185.1",
    "yauzl": "3.2.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.4",
    "@types/yauzl": "2.10.3",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "fflate": "0.8.3",
    "mediabunny": "1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
