{
  "name": "desktop",
  "version": "0.0.0",
  "private": true,
  "description": "OrcaSlicerNeo desktop app (Electron)",
  "author": "OrcaSlicerNeo contributors",
  "license": "AGPL-3.0",
  "main": "out/main/index.js",
  "scripts": {
    "predev": "node ../../scripts/stage-wasm.mjs --soft",
    "dev": "electron-vite dev --noSandbox",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package:win": "electron-vite build && electron-builder --win --x64 --publish never",
    "package:dir": "electron-vite build && electron-builder --dir --publish never",
    "package": "electron-vite build && electron-builder --publish never",
    "postinstall": "install-electron",
    "test:e2e": "electron-vite build --mode e2e && playwright test e2e/app.e2e.ts e2e/slice-error.e2e.ts",
    "test:e2e:real": "electron-vite build && playwright test e2e/app.e2e.ts e2e/slice-error.e2e.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
